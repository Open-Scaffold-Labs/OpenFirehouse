# ── Open Firehouse Server — Environment Variables ──────────────────────────
# Copy this file to .env:  cp .env.example .env
# Then fill in the values below.

# Server port (default 3005)
PORT=3005

# PostgreSQL connection string
# For Supabase: get this from Supabase dashboard → Settings → Database → Connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-random-secret

# Allowed client origins (comma-separated)
# For local dev, localhost:5173 is already included by default
CLIENT_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development

# ── Demo data (PUBLIC DEMO ONLY — leave unset for real deployments) ─────────
# Set to "true" only on the public open-firehouse-client.vercel.app demo.
# When unset (the default), only ERG hazmat reference data + NFPA training
# course catalog are seeded — every department's clean install state.
# When true, ~70 demo seed files populate the fictional Maplewood Fire
# Department for evaluation: 12 members, 18 incidents, 16 apparatus, etc.
# SEED_DEMO=true

# ── Bug-report email forwarding (OPTIONAL) ──────────────────────────────────
# When set, every bug report submitted via the in-app bug reporter is also
# emailed to SUPPORT_EMAIL. Uses Resend (https://resend.com) — free tier
# covers 3,000 emails/month. Get an API key at resend.com → Settings → API.
#
# Without these, the in-app reporter still works — it just stores reports
# in the bug_reports table and runs the AI diagnosis. Nobody gets notified
# externally.
#
# SUPPORT_EMAIL can be a single address or comma-separated list:
#   SUPPORT_EMAIL=chief@yourdept.gov,deputy@yourdept.gov
#
# SUPPORT_FROM_EMAIL defaults to "OpenFirehouse <bugs@openfirehouse.com>"
# but you may need to set it to an address you've verified in Resend.
# SUPPORT_EMAIL=
# RESEND_API_KEY=
# SUPPORT_FROM_EMAIL=

# ── First-run bootstrap (HEADLESS INSTALL ONLY) ─────────────────────────────
# Set these on FIRST deploy only. When OpenFirehouse boots and the users
# table is empty AND these are set, it creates a chief account so you can
# log in. After your first successful login, remove these from .env (or
# leave them — they're ignored once any user exists).
#
# This is the alternative to the Department Setup Wizard for chiefs who
# prefer to configure via env vars rather than a browser UI.
# BOOTSTRAP_CHIEF_USERNAME=chief
# BOOTSTRAP_CHIEF_PASSWORD=change-me-on-first-login
# BOOTSTRAP_CHIEF_NAME=Your Name Here

# ── Optional: AI features ──────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: department-local MCP (agent process on this install) ──────────
# The MCP server (npm run mcp) calls this API with a member or
# service-account JWT — not a chief token. Accept is a human officer
# on the Dashboard. See docs/AGENT-MCP.md.
# OPENFIREHOUSE_API_URL=http://127.0.0.1:3005
# OPENFIREHOUSE_TOKEN=

# ── Optional: Twilio (SMS/alerts) ──────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Optional: Web Push (VAPID keys) ───────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:your@email.com

# ── CAD webhook authentication (REQUIRED in production) ────────────────────
# Shared secret every CAD webhook must present, as header
#   X-CAD-Webhook-Secret: <value>   or   Authorization: Bearer <value>
# or, for relays that can only POST to a plain URL, as a query param
#   ?key=<value>   (or ?secret=<value>).
# In production (Vercel / NODE_ENV=production) the CAD webhook FAILS CLOSED
# (503) until this is set — an unauthenticated dispatch endpoint is a hole.
# In local/dev it may be left unset (webhooks allowed, with a warning).
# CAD_WEBHOOK_SECRET=

# ── CAD integration (OPTIONAL — one per vendor in use) ─────────────────────
# Each CAD adapter has its own env vars. See docs/CAD_SETUP_ACTIVE911.md and
# server/src/cad/adapters/<vendor>.js for setup details.
#
# Active911 — verifies incoming webhook agency_id against this value when set.
# Without this, the webhook URL itself is the only secret.
# ACTIVE911_AGENCY_ID=
#
# IamResponding — shared secret presented in X-IAR-Secret header or "secret"
# field of the payload. Required only when the adapter is taken out of
# scaffold mode (see adapter source for details).
# IAMRESPONDING_WEBHOOK_SECRET=
#
# FirstDue CAD — OAuth 2.0 client credentials, used to introspect bearer
# tokens on incoming webhook calls. Required when the adapter is in production.
# FIRSTDUE_CLIENT_ID=
# FIRSTDUE_CLIENT_SECRET=
#
# Zuercher — API key validated against X-Zuercher-Key header.
# ZUERCHER_API_KEY=

# ── CAD station resolution (OPTIONAL — multi-station deployments only) ─────
# Single-station departments don't need either of these. Default behavior is
# stationId = 1 for every dispatch.
#
# CAD_DEFAULT_STATION_ID overrides the default (1) when no per-agency mapping
# matches. Useful for single-station departments whose stationId in
# OpenFirehouse is not 1.
# CAD_DEFAULT_STATION_ID=1
#
# CAD_STATION_MAP routes dispatches by vendor + vendor-agency-id to a specific
# stationId. Format: JSON object, keys are `<vendor-slug>:<vendor-agency-id>`,
# values are stationIds. Useful when one OpenFirehouse install serves multiple
# stations behind one webhook URL.
# CAD_STATION_MAP='{"active911:ABC123":1,"active911:DEF456":2,"firstdue:tenant-1":3}'
